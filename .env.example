# Example environment variables.
# For use with docker-compose, rename this file to .env

# Database connection string for PostgreSQL
DATABASE_URL=postgresql+asyncpg://ttlrip:ttlrip@db/ttlrip

# Secret key for signing JWTs. Generate a new one for production.
# openssl rand -hex 32
SECRET_KEY=a_much_better_secret_key_should_be_used_in_production

# JWT Algorithm
ALGORITHM=HS256

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
