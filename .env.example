# Example environment variables.
# For use with docker-compose, rename this file to .env

# --- Core App Settings ---
# Set to true for development mode. This enables eager task execution and disables some production checks.
# DEBUG_MODE=False

# --- Security & JWT ---
# Secret key for signing JWTs. Generate a new one for production.
# openssl rand -hex 32
SECRET_KEY=a_much_better_secret_key_should_be_used_in_production

# Encryption key for storing secrets. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=gKm0ZspGDZ-in-T-hXaGNsq4CPGKNIHBXHi_8CiY-0Q=

# JWT Algorithm
ALGORITHM=HS256

# Token expiry in minutes for admin JWTs
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database & Redis ---
# Database connection string for PostgreSQL
DATABASE_URL=postgresql+asyncpg://ttlrip:ttlrip@db/ttlrip

# Redis URL for Celery and caching
REDIS_URL=redis://redis:6379/0

# --- Telegram ---
# Telegram Bot credentials for "Login with Telegram" widget
# Create a bot with @BotFather on Telegram to get these.
# The bot needs a domain configured: /setdomain -> your app's domain
TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=

# Set to true to enable the "Login with Telegram" widget.
TELEGRAM_AUTH_ENABLED=false

# --- Scheduler & Worker ---
# Scheduler check interval in seconds
SCHEDULER_INTERVAL_SECONDS=5

# Set to true to automatically start a Celery worker inside the main app process.
# Useful for simple, single-container deployments. Not recommended for production.
AUTO_START_EMBEDDED_WORKER=False

# Number of threads for the embedded Celery worker.
WORKER_CONCURRENCY=50

# Celery scheduling mode
# If set to 1, embed Celery Beat inside the worker (worker runs with -B).
# If set to 0, run a separate Beat service (recommended for production).
EMBED_BEAT=0

# --- Cleanup ---
# Enable or disable the automatic cleanup of old, inactive data.
CLEANUP_ENABLED=False

# Number of days of inactivity before a check or user is considered for cleanup.
CLEANUP_INACTIVE_DAYS=180

# How often the cleanup task runs, in hours.
CLEANUP_INTERVAL_HOURS=24

# --- GeoIP & Logging ---
# Log levels
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info
# Enable or disable saving the last 3 ping logs for each check.
SAVE_CHECK_LAST_LOGS=True

# Absolute path to the MaxMind GeoLite2 City database file (.mmdb).
# If not set, GeoIP lookups will be disabled.
# GEOIP_DATABASE_PATH=/path/to/GeoLite2-City.mmdb

# --- Caching ---
# Time-to-live in seconds for cached user stats.
STATS_CACHE_TTL_SECONDS=10

# Redis counters buffer (best-effort). Tune durability vs overhead.
# Disable to write counters directly (most durable, higher Redis load).
INCR_BUFFER_ENABLED=true
# Flush interval in milliseconds (time-based trigger).
INCR_BUFFER_FLUSH_INTERVAL_MS=500
# Flush when this many buffer operations have accumulated (size-based trigger).
INCR_BUFFER_MAX_OPS=200

# --- Cloudflare Tunnel (optional) ---
# Provide a named-tunnel token from Cloudflare Zero Trust to expose Caddy.
# If empty, a temporary Quick Tunnel will be created with a random trycloudflare.com subdomain.
CLOUDFLARED_TOKEN=
# Override the local service URL if needed.
CLOUDFLARED_URL=http://caddy:8080
# Additional flags for cloudflared (e.g., --protocol http2)
CLOUDFLARED_OPTS=
