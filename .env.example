# Example environment variables.
# For use with docker-compose, rename this file to .env

# Database connection string for PostgreSQL
DATABASE_URL=postgresql+asyncpg://ttlrip:ttlrip@db/ttlrip

# Secret key for signing JWTs. Generate a new one for production.
# openssl rand -hex 32
SECRET_KEY=a_much_better_secret_key_should_be_used_in_production

# Encryption key for storing secrets. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# JWT Algorithm
ALGORITHM=HS256

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Telegram Bot credentials for "Login with Telegram" widget
# Create a bot with @BotFather on Telegram to get these.
# The bot needs a domain configured: /setdomain -> your app's domain
TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=

# Set to true to enable the "Login with Telegram" widget.
# If false, you can manually enter bot tokens and chat IDs for testing.
TELEGRAM_AUTH_ENABLED=false

# Redis URL for Celery
REDIS_URL=redis://redis:6379/0

# Scheduler check interval in seconds
# SCHEDULER_INTERVAL_SECONDS=5
