{
    # Global Caddy options
    admin off  # Disable admin API for security in container
    auto_https off  # We'll handle HTTPS at the ingress level
    log {
        format json
    }
    # Add rate_limit ordering to ensure it runs before reverse_proxy
    order rate_limit before reverse_proxy
    
}

:8080 {
    # Enable Brotli and Zstandard compression
    encode brotli zstd gzip

    # Enable response header to show when caching is active
    header /* {
        X-Cache-Status {http.cache.status}
    }

    # Global rate limiting - 10 req/s with burst of 20
    rate_limit {
        zone global {
            key {remote_host}
            events 10
            window 1s
            burst 20
        }
    }

    # Enhanced cache configuration with micro-caching for GET/HEAD requests
    cache {
        # Default micro-caching TTL for successful responses (10s)
        ttl 10s
        
        # Don't cache non-GET/HEAD methods or requests with authorization
        disable_if {
            not {method} match GET HEAD
            header Authorization *
            header X-Auth-Key *
        }
        
        # Cache key based on request attributes (do not include conditional headers to avoid fragmentation)
        key {
            method
            host
            path
            query
            header Accept
        }
    }

    # Handle /static/ path with longer cache time
    handle /static/* {
        # Higher rate limit for static assets
        rate_limit {
            zone static {
                key {remote_host}
                events 50
                window 1s
                burst 100
            }
        }
        
        # Longer cache time for static assets
        cache {
            ttl 1h
        }
        
        # Add cache control header for browsers
        header Cache-Control "public, max-age=3600"
        
        # Standard file server for static files
        file_server
    }

    # Handle login attempts to prevent brute-forcing
    handle /api/v1/token {
        @login method POST
        rate_limit @login {
            zone login_attempts {
                key {remote_host}
                events 10    # 10 login attempts per minute per IP
                window 60s
                burst 5
            }
        }
        reverse_proxy localhost:8000
    }

    # Handle sensitive user actions like key rotation and account deletion
    handle /api/v1/user* {
        @user_actions method POST DELETE
        rate_limit @user_actions {
            zone user_actions {
                key {http.request.header.X-Auth-Key}
                events 5     # 5 sensitive actions per hour per user
                window 1h
                burst 2
            }
        }
        reverse_proxy localhost:8000
    }

    # Handle check creation (which also handles new user creation)
    handle /api/v1/checks {
        # Stricter limit for check creation (POST), keyed by IP to prevent new user spam
        @create_check method POST
        rate_limit @create_check {
            zone create_check_by_ip {
                key {remote_host}
                events 15    # 15 creations per minute per IP, to prevent user spam while allowing normal use
                window 60s
                burst 5
            }
        }
        
        # Pass to FastAPI backend
        reverse_proxy localhost:8000
    }

    # Handle admin login with rate limiting
    handle /admin/login {
        @admin_login method POST
        rate_limit @admin_login {
            zone admin_login {
                key {remote_host}
                events 10
                window 60s
                burst 5
            }
        }
        reverse_proxy localhost:8000
    }

    # Handle admin token refresh with primary cookie-based and fallback IP rate limits
    handle /admin/token/refresh {
        @refresh method POST
        rate_limit @refresh {
            zone admin_refresh_cookie {
                key {http.request.cookie.admin_refresh}
                events 12
                window 10m
                burst 2
            }
        }
        rate_limit {
            zone admin_refresh_ip {
                key {remote_host}
                events 30
                window 10m
                burst 5
            }
        }
        reverse_proxy localhost:8000
    }

    handle /api/v1/* {
        # Rate limiting based on auth type with fallback to IP
        @api_with_auth_key header X-Auth-Key *
        @api_with_bearer header Authorization Bearer*
        @api_no_auth not {
            header X-Auth-Key *
            header Authorization *
        }

        rate_limit @api_with_auth_key {
            zone authenticated_api {
                key {http.request.header.X-Auth-Key}
                events 120
                window 60s
                burst 30
            }
        }
        rate_limit @api_with_bearer {
            zone admin_api {
                key {http.request.header.Authorization}
                events 240
                window 60s
                burst 60
            }
        }
        rate_limit @api_no_auth {
            zone api_by_ip {
                key {remote_host}
                events 60
                window 60s
                burst 20
            }
        }

        # Specific limit for metrics summary (public)
        @metrics_summary path /api/v1/metrics/summary
        rate_limit @metrics_summary {
            zone metrics_ip {
                key {remote_host}
                events 60
                window 60s
                burst 20
            }
        }
        
        # Micro-caching for API endpoints - 5 seconds
        cache {
            ttl 5s

            # Only cache GET requests for API endpoints
            disable_if {
                not {method} match GET
            }

            # Key the cache by auth and method to prevent cross-user leaks; avoid conditional headers
            key {
                method
                host
                path
                query
                header Accept
                header X-Auth-Key
                header Authorization
            }
        }
        
        # Add cache control header
        header Cache-Control "public, max-age=5"
        
        # Pass to FastAPI backend
        reverse_proxy localhost:8000
    }

    # Special handling for ping and badge endpoints
    @badge path_regexp badge ^/p/.+/badge\.svg$
    handle @badge {
        # Cache badges (static-ish) for 30s
        cache {
            ttl 30s
        }
        header Cache-Control "public, max-age=30"
        reverse_proxy localhost:8000
    }

    # All other /p/* routes are active pings; do not cache, add limits
    @ping not @badge
    handle @ping {
        # Per-check limiter (by path)
        rate_limit {
            zone ping_per_check {
                key {path}
                events 120
                window 60s
                burst 30
            }
        }
        # Per-IP limiter
        rate_limit {
            zone ping_per_ip {
                key {remote_host}
                events 600
                window 60s
                burst 100
            }
        }
        reverse_proxy localhost:8000
    }

    # Handle all other requests
    handle {
        reverse_proxy localhost:8000
    }

    # Comprehensive security headers for all responses
    header /* {
        # HSTS: Tell browsers to always use HTTPS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        
        # Control how your site can be framed
        X-Frame-Options "DENY"
        
        # Referrer policy to control information sent in Referer header
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Content Security Policy to mitigate XSS attacks
        Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; object-src 'none'; media-src 'self'; frame-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
        
        # Feature Policy to limit which browser features your site can use
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=(), interest-cohort=()"
        
        # Legacy XSS protection - less relevant for modern browsers but still useful
        X-XSS-Protection "1; mode=block"
        
        # Remove unnecessary headers
        -Server
        -X-Powered-By
    }
}
