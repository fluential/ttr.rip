# Build a custom Caddy with required plugins
FROM caddy:2-builder AS caddy-builder
RUN xcaddy build \
    --with github.com/mholt/caddy-ratelimit \
    --with github.com/caddyserver/cache-handler

# Final runtime image for Caddy
FROM caddy:2
COPY --from=caddy-builder /usr/bin/caddy /usr/bin/caddy

# Create cache directory for Caddy cache-handler
RUN mkdir -p /var/cache/caddy
